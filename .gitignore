# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


# Virtual environments
.env
.venv

# Jupyter Notebook
.ipynb_checkpoints

# macOS
.DS_Store

.?*cache
.coverage

# cached model responses, keyed by prompt hash -- never committed, would re-bill on every
# checkout otherwise; explicit rule, not swallowed by the tool-cache glob above (which no
# longer matches bare ".cache" -- see the ".?*cache" narrowing, kept for .pytest_cache/
# .mypy_cache/.ruff_cache/etc.)
.cache/responses/


